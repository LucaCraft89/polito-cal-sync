# polito-cal-sync: copy to .env (optional: nothing here is needed to start).
#
# Only settings of the SERVER itself are active below. Everything you can also change in the web page
# (Settings, Sources, Service) is commented out on purpose: a variable that is set here WINS over the page and
# locks that field there ("set by an environment variable"). Uncomment one only if you want it fixed from here.
# Placeholders only: real values live in the data folder (private files) or here; never commit this file.

# ---- the web page and the service ----------------------------------------------------------------
# The web page (docs/UI.md), on by default: http://<this machine>:8787
UI_ENABLED=true
# Who can open it. 0.0.0.0 = every device on your network, by the server's IP address
# (http://192.168.1.20:8787). The page asks for a passphrase but has no HTTPS: use a trusted network or a VPN.
# 127.0.0.1 = this machine only. BIND_ADDRESS publishes the Docker port; STATUS_BIND is the address inside the
# container (or without Docker).
BIND_ADDRESS=0.0.0.0
STATUS_BIND=0.0.0.0
STATUS_PORT=8787
# The first-run step (choosing the passphrase) works only through http://localhost:8787 on the server itself.
# Connecting Google also needs to be done from the server (Google sends the browser back to 127.0.0.1).
# Names other than localhost (a DNS name for the server) must be listed here, comma separated; an IP address needs nothing.
# UI_ALLOWED_HOSTS=calendar.home.lan
# true when a TLS proxy is in front: cookies get Secure, Origin must be https.
# UI_HTTPS=false
# fatal|error|warn|info|debug|trace|silent
LOG_LEVEL=info
# Where logins, settings and history live. Never commit. Leave unset: ./data without Docker, /data in the image.
# DATA_DIR=./data
# Where "Connect Google" waits for Google to send the browser back (0 = any free port; the Docker image uses 8789).
# GOOGLE_AUTH_PORT=0
# GOOGLE_AUTH_BIND=127.0.0.1

# ---- everything below can be set in the web page: commented out so the page stays in control ------
# TZ=Europe/Rome
# SYNC_AUTO=true
# SYNC_INTERVAL_MINUTES=60
# Refuse a sync that would delete more than this share (0..1) of our events.
# DELETE_THRESHOLD=0.3

# Google OAuth client (create it in the Google Cloud console, type "Desktop app"; see docs/SETUP.md)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# The dedicated calendar is created or picked in the page; set an id here only to fix it.
# GOOGLE_CALENDAR_ID=
# Keep Moodle events in a second Google calendar of their own (the [Moodle] label stays in the title).
# CALENDAR_SPLIT_MOODLE=false
# GOOGLE_MOODLE_CALENDAR_ID=

# Calendar feed link(s) of your courses, comma separated. They can contain a secret token.
# SOURCE_POLITO_ICS_URLS=
# Polito student portal (same login as a browser; see docs/SETUP.md). If the university refuses the password,
# syncing it is paused until the password changes.
# SOURCE_POLITO_PORTAL_ENABLED=false
# POLITO_USERNAME=
# POLITO_PASSWORD=
# booked (default): only exam calls you booked. all: every open call.
# POLITO_EXAM_CALLS=booked
# Your squad per course, <course id>=<squad>,... e.g. 222222=B,333333=2 (the Sources page lists them for you).
# POLITO_SQUADS=
# Live Moodle events, with the same university login. Remove a Moodle calendar feed when you switch this on.
# SOURCE_MOODLE_ENABLED=false
# MOODLE_BASE_URL=https://moodle.polito.it
# Moodle course ids (comma list) whose events are left out; the Sources page fills this in.
# MOODLE_EXCLUDED_COURSES=
