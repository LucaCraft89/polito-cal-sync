# Placeholders only. Real values go in .env (git-ignored) or are created by the setup wizard in ./data.
TZ=Europe/Rome
SYNC_INTERVAL_MINUTES=60
# Refuse a sync that would delete more than this share (0..1) of our events; override with `sync --force`.
DELETE_THRESHOLD=0.3
# fatal|error|warn|info|debug|trace|silent
LOG_LEVEL=info
# Where state, tokens and the sqlite db live. Never commit.
# (Leave DATA_DIR unset when running with pnpm: it defaults to ./data. The Docker image sets /data itself.)
# DATA_DIR=./data
# Google OAuth client (create in Google Cloud Console, type "Desktop" or "Web", see docs/SETUP.md)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The dedicated calendar is created or picked by `auth google` and remembered in DATA_DIR; set an id here only to override.
GOOGLE_CALENDAR_ID=
# Sources: enable only what you use
# Calendar feed URL(s) of your courses, comma separated. They can contain a secret token: keep them only in .env.
SOURCE_POLITO_ICS_URLS=
# Polito student portal (same login as a browser; see docs/decisions/018 and docs/M3-RUNBOOK.md).
# Keep POLITO_PASSWORD only in .env. If the university login refuses it, syncing it is paused until it changes.
SOURCE_POLITO_PORTAL_ENABLED=false
# booked (default): only exam calls you booked. all: every open call (about 35 for 8 courses).
POLITO_EXAM_CALLS=booked
POLITO_USERNAME=
POLITO_PASSWORD=
SOURCE_MOODLE_ENABLED=false
MOODLE_BASE_URL=https://moodle.polito.it
# Local status page (127.0.0.1 only; 0 turns it off). In Docker the image binds 0.0.0.0 inside the container
# and compose publishes it on the host's 127.0.0.1 only.
STATUS_PORT=8787
STATUS_BIND=127.0.0.1
